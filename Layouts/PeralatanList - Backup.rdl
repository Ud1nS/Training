        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=First(Fields!GeneratedOnLbl.Value, "DataSet_Result") &amp; ": " &amp; Format(First(Fields!GeneratedOnValue.Value, "DataSet_Result"), "dd/MM/yyyy")</Value>
